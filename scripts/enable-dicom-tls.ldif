dn: cn=dicom-tls,dicomDeviceName=dcm4chee-arc,cn=Devices,cn=DICOM Configuration,dc=dcm4che,dc=org
changetype: modify
replace: dicomTLSCipherSuite
dicomTLSCipherSuite: TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
dicomTLSCipherSuite: TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
-
replace: dcmTLSProtocol
